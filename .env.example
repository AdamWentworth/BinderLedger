# BinderLedger API
HTTP_ADDR=127.0.0.1:4000
DATABASE_URL=postgres://binder_ledger_dev:binder_ledger_dev@127.0.0.1:5433/binder_ledger_dev?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CARD_IMAGE_DIR=data/card-images

# Expo client. Use this machine's LAN address when testing on a phone.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# JustTCG collector (keep the real value only in .env)
JUSTTCG_API_KEY=
JUSTTCG_BASE_URL=https://api.justtcg.com/v1
JUSTTCG_REQUEST_INTERVAL_MS=6500
JUSTTCG_DAILY_REQUEST_RESERVE=5

# PokemonPriceTracker secondary pricing source (keep the real value only in .env)
POKEMON_PRICE_TRACKER_API_KEY=
POKEMON_PRICE_TRACKER_REQUEST_INTERVAL_MS=1250
POKEMON_PRICE_TRACKER_DAILY_CREDIT_BUDGET=80

# PkmnPrices historical pricing and JustTCG fallback source (keep the real value only in .env)
PKMNPRICES_API_KEY=
PKMNPRICES_BASE_URL=https://api.pkmnprices.com/v1
PKMNPRICES_HISTORY_ENABLED=false
PKMNPRICES_REQUEST_INTERVAL_MS=1250
PKMNPRICES_DAILY_CREDIT_BUDGET=80
