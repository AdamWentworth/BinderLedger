{
  "expo": {
    "name": "BinderLedger",
    "slug": "binderledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/binderledger-icon-circle.png",
    "scheme": "binderledger",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/binderledger-icon-circle.png",
      "bundleIdentifier": "com.adamwentworth.binderledger"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#06182F",
        "foregroundImage": "./assets/images/binderledger-icon-circle.png"
      },
      "package": "com.adamwentworth.binderledger",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/binderledger-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06182F",
          "image": "./assets/images/binderledger-mark.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BinderLedger to photograph cards for cataloging and condition review.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45908809-1cea-47e6-bd90-3a0a94a23f7e"
      }
    },
    "owner": "adamwentworth",
    "updates": {
      "url": "https://u.expo.dev/45908809-1cea-47e6-bd90-3a0a94a23f7e"
    }
  }
}
