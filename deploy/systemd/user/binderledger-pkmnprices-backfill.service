[Unit]
Description=Run the quota-safe BinderLedger PkmnPrices history backfill
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/adam/src/BinderLedger
EnvironmentFile=/home/adam/src/BinderLedger/.env
ExecStart=/home/adam/src/BinderLedger/bin/binderledger-pkmnprices-backfill
Nice=10
IOSchedulingClass=idle
CPUWeight=10
MemoryHigh=192M
MemoryMax=256M
TimeoutStartSec=20min
