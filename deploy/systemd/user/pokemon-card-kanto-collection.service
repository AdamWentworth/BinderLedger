[Unit]
Description=Resume the rate-limited JustTCG Kanto collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/BinderLedger/tools/justtcg-audit
ExecStart=%h/src/BinderLedger/tools/justtcg-audit/scripts/run-scheduled-kanto-collection.sh
Nice=10
IOSchedulingClass=idle
CPUWeight=10
MemoryHigh=1G
MemoryMax=1536M
TimeoutStartSec=2h
