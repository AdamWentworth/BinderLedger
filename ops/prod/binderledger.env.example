# Keep the real file at /srv/binderledger/.env and never commit it.
# POSTGRES_PASSWORD must be URL-safe because it is interpolated into DATABASE_URL.
POSTGRES_DB=binderledger
POSTGRES_USER=binderledger
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

BINDERLEDGER_STORAGE_MOUNT=/mnt/storage
BINDERLEDGER_POSTGRES_DATA_DIR=/mnt/storage/binderledger/postgres
BINDERLEDGER_CARD_IMAGE_DIR=/mnt/storage/binderledger/card-images
BINDERLEDGER_SCAN_IMAGE_DIR=/mnt/storage/binderledger/scan-images

BINDERLEDGER_BIND_HOST=192.168.1.77
BINDERLEDGER_API_PORT=4000
BINDERLEDGER_WEB_PORT=8081
CORS_ALLOWED_ORIGINS=http://192.168.1.77:8081,http://localhost:8081,http://127.0.0.1:8081

VISION_POLL_SECONDS=3
VISION_TESSERACT_ENABLED=true

# Production market-price refresh runs before historical expansion. During
# bootstrap it uses 20 batches/day; after all 38 sets arrive it uses 28.
JUSTTCG_API_KEY=replace_me
JUSTTCG_BASE_URL=https://api.justtcg.com/v1
JUSTTCG_REQUEST_INTERVAL_MS=6500
JUSTTCG_DAILY_REFRESH_REQUEST_BUDGET=28
JUSTTCG_BOOTSTRAP_DAILY_REFRESH_REQUEST_BUDGET=20
JUSTTCG_HISTORICAL_DAILY_REQUEST_BUDGET=8
JUSTTCG_DAILY_REQUEST_RESERVE=5
JUSTTCG_MONTHLY_REQUEST_RESERVE=100
JUSTTCG_LEGACY_TARGET_SET_COUNT=38
BINDERLEDGER_JUSTTCG_COLLECTOR_DIR=/mnt/storage/binderledger/justtcg-collector
